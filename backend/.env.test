# Environment for automated tests (vitest e2e). Points at a dedicated database in the same
# local Docker Postgres+PostGIS container used for dev (see ../docker-compose.yml) — never runs
# against the real Supabase project. Safe to commit: local-only credentials, no real secrets.

NODE_ENV=test
PORT=3100
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001

DATABASE_URL="postgresql://diakmarket:diakmarket@localhost:5433/diakmarket_test"
DIRECT_URL="postgresql://diakmarket:diakmarket@localhost:5433/diakmarket_test"
SHADOW_DATABASE_URL="postgresql://diakmarket:diakmarket@localhost:5433/diakmarket_test_shadow"

# Fixed HS256 secret so tests can mint their own Supabase-shaped JWTs deterministically,
# without needing a real Supabase project or network access — see test/utils/test-jwt.ts.
SUPABASE_URL=https://test-project.supabase.co
SUPABASE_JWT_SECRET=test-only-hs256-secret-never-used-outside-automated-tests
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=

CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
CLOUDINARY_UPLOAD_PRESET=test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_WEBHOOK_SECRET=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_SECRET=
MOOV_MONEY_WEBHOOK_SECRET=

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
