# =====================================================================================
# DiakMarket Backend — environment variables
# Copy this file to .env for local development. NEVER commit the real .env file.
# In staging/production, set these via your secret manager / platform env vars, not files.
# =====================================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# --- Database (Supabase PostgreSQL) ---
# db.<ref>.supabase.co (the "Direct connection" host) is IPv6-only — unreachable from most local
# networks and CI runners. Use Supavisor (Project Settings > Database > Connection Pooling)
# instead, in SESSION mode (port 5432), for BOTH variables below:
#   postgresql://postgres.<ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres
# Do NOT use transaction mode (port 6543) for a long-lived server process: `pg` (used by
# @prisma/adapter-pg) issues server-side prepared statements by default, and PgBouncer
# transaction mode reassigns the backend connection between statements, so one client's prepared
# statement can collide with another's — this surfaced as spurious/random unique-constraint
# errors on writes to tables that had no relevant unique constraint at all. Session mode pins one
# backend connection per client, avoiding the collision. Transaction mode is only appropriate for
# high-churn serverless functions, not this backend.
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-x-region.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxxxxxx:password@aws-x-region.pooler.supabase.com:5432/postgres"
# Shadow database used by `prisma migrate dev` to compute diffs — local dev only (e.g. the Docker
# Postgres from ../docker-compose.yml); `migrate deploy` never touches it, but prisma.config.ts
# still requires the variable to exist.
SHADOW_DATABASE_URL="postgresql://diakmarket:diakmarket@localhost:5433/diakmarket_shadow"

# --- Supabase Auth ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Public anon key — safe to expose to Flutter, but NestJS still needs it to verify project identity.
SUPABASE_ANON_KEY=
# SERVICE ROLE KEY — NEVER expose this to Flutter or any client. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty for current Supabase projects (sb_publishable_/sb_secret_ key format): tokens are
# signed with an asymmetric key, verified automatically via JWKS at
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json — confirmed working end-to-end. Only set this for
# a legacy project still on the shared HS256 "JWT Secret" (Project Settings > API).
SUPABASE_JWT_SECRET=

# --- Cloudinary ---
# Cloud name / API key / API secret from console.cloudinary.com > Dashboard.
# If you generate a scoped API key (Settings > Access Keys) instead of using the account's
# default key, make sure it has the "Create" (upload) permission — a scoped key without it
# fails signed uploads with "Request forbidden due to missing permissions (actions=[create])",
# not an auth error, so it's easy to mistake for a wrong signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload preset used for unsigned/signed client uploads from Flutter (products, avatars, disputes).
CLOUDINARY_UPLOAD_PRESET=diakmarket_uploads

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Payment Providers (per-country credentials; non-secret routing lives in DB) ---
WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_WEBHOOK_SECRET=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_SECRET=
MOOV_MONEY_WEBHOOK_SECRET=

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
