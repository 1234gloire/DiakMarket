# =====================================================================================
# DiakMarket Backend — environment variables
# Copy this file to .env for local development. NEVER commit the real .env file.
# In staging/production, set these via your secret manager / platform env vars, not files.
# =====================================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# --- Database (Supabase PostgreSQL) ---
# Pooled connection (pgbouncer, port 6543) — used at runtime.
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxx.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — required for `prisma migrate`.
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres"
# Shadow database used by `prisma migrate dev` to compute diffs (local dev only; optional on Supabase).
SHADOW_DATABASE_URL="postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres_shadow"

# --- Supabase Auth ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Public anon key — safe to expose to Flutter, but NestJS still needs it to verify project identity.
SUPABASE_ANON_KEY=
# SERVICE ROLE KEY — NEVER expose this to Flutter or any client. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to verify Supabase-issued access tokens (Project Settings > API > JWT Secret).
SUPABASE_JWT_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload preset used for unsigned/signed client uploads from Flutter (products, avatars, disputes).
CLOUDINARY_UPLOAD_PRESET=diakmarket_uploads

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Payment Providers (per-country credentials; non-secret routing lives in DB) ---
WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_WEBHOOK_SECRET=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_SECRET=
MOOV_MONEY_WEBHOOK_SECRET=

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
