# Copy to .env and fill in. Never commit the real .env.
#
# SUPABASE_ANON_KEY is designed to be embedded in client apps (it's public-safe on its own —
# Supabase enforces access via RLS/JWT claims, and NestJS never trusts it for authorization).
# Never put the SUPABASE_SERVICE_ROLE_KEY here or anywhere in this app.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# NestJS API base URL, including the /api/v1 prefix.
# Android emulator -> host machine: http://10.0.2.2:3000/api/v1
# iOS simulator / desktop -> http://localhost:3000/api/v1
# Physical device on the same network -> http://<your-lan-ip>:3000/api/v1
API_BASE_URL=http://10.0.2.2:3000/api/v1
